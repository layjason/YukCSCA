# Copy to .env and fill required values before running the stack.
# Never commit .env.

# PostgreSQL (Compose infra + local API profile)
POSTGRES_DB=yukcsca
POSTGRES_USER=yukcsca
POSTGRES_PASSWORD=yukcsca-local
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/yukcsca
DB_USERNAME=yukcsca
DB_PASSWORD=yukcsca-local

# Local verification inbox and SMTP
MAILPIT_UI_PORT=8025
SMTP_PORT=1025

# Google Identity Services — same Web Client ID on both sides
GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id

# YukCSCA session signing (minimum 32 bytes)
YUKCSCA_JWT_SECRET=local-development-secret-change-this-now
YUKCSCA_AUTH_ISSUER=http://localhost:8080
YUKCSCA_WEB_ORIGIN=http://localhost:5173
YUKCSCA_COOKIE_SECURE=false
YUKCSCA_COOKIE_SAME_SITE=Lax
# Exact verified account promoted to the single pilot admin on successful sign-in.
YUKCSCA_FIRST_ADMIN_EMAIL=admin@example.com
YUKCSCA_CREDENTIAL_AUTH_ENABLED=true
YUKCSCA_VERIFICATION_SECRET=local-verification-secret-32-bytes-minimum
YUKCSCA_VERIFICATION_WEB_ORIGIN=http://localhost:5173
YUKCSCA_TERMS_VERSION=TERMS_V1
YUKCSCA_PRIVACY_NOTICE_VERSION=PRIVACY_V1
YUKCSCA_VERIFICATION_MAIL_FROM=no-reply@yukcsca.local
# gTTS (ADR-0003) at package publish only. Default off; set true to store zh-CN term clips.
YUKCSCA_SPEECH_ENABLED=false
YUKCSCA_SPEECH_TIMEOUT=8s
YUKCSCA_SPEECH_MAX_CLIPS_PER_PUBLISH=200
# VS-011 contextual Ask. Default off; set true and provide an OpenAI-compatible key locally.
YUKCSCA_AGENT_ENABLED=false
YUKCSCA_AGENT_API_KEY=
YUKCSCA_AGENT_BASE_URL=https://api.x.ai
YUKCSCA_AGENT_CHAT_MODEL=grok-4
YUKCSCA_AGENT_EMBEDDING_MODEL=text-embedding-3-small
YUKCSCA_AGENT_DAILY_TURN_CAP=40
YUKCSCA_AGENT_TURN_TIMEOUT=8s
# Reviewed-video object storage (MinIO in Compose). CORS origin must match the web origin.
# API/worker service endpoint and browser-reachable presigned-URL endpoint.
YUKCSCA_MEDIA_ENDPOINT=http://localhost:9000
YUKCSCA_MEDIA_PUBLIC_ENDPOINT=http://localhost:9000
YUKCSCA_MEDIA_BUCKET=yukcsca-media
YUKCSCA_MEDIA_ACCESS_KEY=yukcsca-local
YUKCSCA_MEDIA_SECRET_KEY=yukcsca-local-secret
MINIO_PORT=9000
API_PORT=8080
WEB_PORT=5173
